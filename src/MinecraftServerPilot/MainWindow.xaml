<Window x:Class="MinecraftServerPilot.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Minecraft Server Pilot"
        Width="1180" Height="760" MinWidth="980" MinHeight="650"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#121820" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1" Padding="28,19">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="38" Height="38" CornerRadius="9" Background="#203B2C" Margin="0,0,12,0">
                            <TextBlock Text="◆" Foreground="{StaticResource AccentBrush}" FontSize="21"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel>
                            <TextBlock Text="Minecraft Server Pilot" FontSize="22" FontWeight="Bold" />
                            <TextBlock Text="高容错 · 可追溯 · 面向 Windows 10 / 11" Foreground="{StaticResource MutedBrush}"
                                       FontSize="12" Margin="0,3,0,0" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
                <Border Grid.Column="1" Background="#16281E" BorderBrush="#285C3C" BorderThickness="1"
                        CornerRadius="12" Padding="12,6" VerticalAlignment="Center">
                    <TextBlock x:Name="StatusBadge" Text="●  准备就绪" Foreground="#70E39B" FontSize="12" />
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="24,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="410" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="22">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="创建新的服务端" FontSize="18" FontWeight="Bold" />
                        <TextBlock Text="选完必要信息后，其余交给程序。" Foreground="{StaticResource MutedBrush}"
                                   Margin="0,5,0,12" />

                        <Grid Margin="0,0,0,18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="ManageExistingButton" Content="管理已有服务端"
                                    Click="ManageExistingButton_OnClick" Padding="10,7" />
                            <Button x:Name="PropertiesButton" Grid.Column="2" Content="服务端设置"
                                    Click="PropertiesButton_OnClick" Padding="10,7" IsEnabled="False" />
                            <Button x:Name="NetworkGuideButton" Grid.Column="4" Content="联机指南"
                                    Click="NetworkGuideButton_OnClick" Padding="10,7" IsEnabled="False" />
                        </Grid>

                        <TextBlock Text="安装方式" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <Border Background="#0D1117" CornerRadius="8" BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1" Padding="12">
                            <StackPanel>
                                <RadioButton x:Name="AutomaticModeRadio" IsChecked="True"
                                             Content="全自动安装（推荐）" GroupName="Mode" />
                                <TextBlock Text="选好位置后自动同意必要操作并完成双重验证。"
                                           Foreground="{StaticResource MutedBrush}" FontSize="11"
                                           Margin="22,4,0,10" TextWrapping="Wrap" />
                                <RadioButton x:Name="GuidedModeRadio" Content="引导安装" GroupName="Mode" />
                                <TextBlock Text="先显示摘要供确认，过程与错误持续显示在右侧。"
                                           Foreground="{StaticResource MutedBrush}" FontSize="11"
                                           Margin="22,4,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Grid Margin="0,18,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Minecraft 版本" FontWeight="SemiBold" Margin="0,0,0,7" />
                                <ComboBox x:Name="VersionCombo" IsEditable="True"
                                          IsTextSearchEnabled="True" Height="36"
                                          SelectionChanged="VersionCombo_OnSelectionChanged"
                                          LostKeyboardFocus="VersionCombo_OnLostKeyboardFocus"
                                          ToolTip="可输入 1.7.10 等精确版本" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="服务端类型" FontWeight="SemiBold" Margin="0,0,0,7" />
                                <ComboBox x:Name="KindCombo" Height="36" SelectionChanged="KindCombo_OnSelectionChanged">
                                    <ComboBoxItem Content="原版 Vanilla" Tag="Vanilla" IsSelected="True" />
                                    <ComboBoxItem Content="插件服 Paper" Tag="Paper" />
                                    <ComboBoxItem Content="模组服 Fabric" Tag="Fabric" />
                                    <ComboBoxItem Content="模组服 Forge" Tag="Forge" />
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="安装到" FontWeight="SemiBold" Margin="0,18,0,7" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="PathTextBox" VerticalContentAlignment="Center" />
                            <Button Grid.Column="2" Content="选择…" Click="BrowseButton_OnClick" Padding="13,8" />
                        </Grid>
                        <TextBlock Text="程序会在这里创建英文命名的独立文件夹，不覆盖已有服务端。"
                                   Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,5,0,0"
                                   TextWrapping="Wrap" />

                        <TextBlock Text="内存（MB）" FontWeight="SemiBold" Margin="0,18,0,7" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="最小" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                                <TextBox x:Name="MinMemoryTextBox" Text="1024" Margin="0,4,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="最大" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                                <TextBox x:Name="MaxMemoryTextBox" Text="4096" Margin="0,4,0,0" />
                            </StackPanel>
                        </Grid>

                        <CheckBox x:Name="ProbeCheckBox" IsChecked="True" Margin="0,18,0,0">
                            <TextBlock Text="安装一次性测试组件并执行双重启动验证" TextWrapping="Wrap" />
                        </CheckBox>
                        <CheckBox x:Name="KeepRunningCheckBox" IsChecked="False" Margin="0,10,0,0"
                                  Content="交付后保持服务端运行" />
                        <CheckBox x:Name="AutoJavaCheckBox" IsChecked="True" Margin="0,10,0,0">
                            <TextBlock Text="缺少 Java 时自动下载免安装便携版" TextWrapping="Wrap" />
                        </CheckBox>

                        <Border x:Name="CompatibilityCard" Background="#151F2B" BorderBrush="#29445D"
                                BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,18,0,0">
                            <TextBlock x:Name="CompatibilityText" Foreground="#B9D8F2" FontSize="11"
                                       TextWrapping="Wrap"
                                       Text="原版兼容范围最广；程序将读取 Mojang 清单中的 Java 要求并验证 SHA-1。" />
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Border Grid.Column="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="22,19,22,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="执行中心" FontSize="18" FontWeight="Bold" />
                            <TextBlock x:Name="StageText" Text="正在获取版本列表…"
                                       Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="打开日志" Click="OpenLogButton_OnClick"
                                Padding="12,7" VerticalAlignment="Center" />
                    </Grid>

                    <Grid Grid.Row="1" Margin="22,0,22,14">
                        <ProgressBar x:Name="MainProgress" Height="7" Minimum="0" Maximum="100"
                                     Value="0" Foreground="{StaticResource AccentBrush}" Background="#0D1117" />
                    </Grid>

                    <Border Grid.Row="2" Background="#090D12" BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1,1,1,0" Margin="0">
                        <TextBox x:Name="LogTextBox" IsReadOnly="True" AcceptsReturn="True"
                                 TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto" BorderThickness="0"
                                 Background="#090D12" Foreground="#C9D1D9"
                                 FontFamily="Cascadia Mono, Consolas" FontSize="11" Padding="16" />
                    </Border>

                    <Border Grid.Row="3" Background="#121820" Padding="18,14" CornerRadius="0,0,12,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="FooterHint" Text="下载失败会自动换源；所有技术细节都会写入日志。"
                                       Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"
                                       TextWrapping="Wrap" Margin="0,0,15,0" />
                            <Button x:Name="CancelButton" Grid.Column="1" Content="取消安装"
                                    Click="CancelButton_OnClick" IsEnabled="False"
                                    Visibility="Collapsed" MinWidth="104" />
                            <Button x:Name="StartButton" Grid.Column="3" Content="开始创建服务端"
                                    Click="StartButton_OnClick" Background="#238636" BorderBrush="#2EA043"
                                    MinWidth="154" />
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="#090D12" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0" Padding="24,10">
            <TextBlock Text="官方源优先  →  权威备用源  →  国内镜像  ·  完整文件校验  ·  不静默吞掉任何异常"
                       Foreground="{StaticResource MutedBrush}" FontSize="11" HorizontalAlignment="Center" />
        </Border>
    </Grid>
</Window>
